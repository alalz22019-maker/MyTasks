function getStarData(id){return state['star_'+id]||{situation:'',task:'',action:'',result:'',done:false};}
function isTermMastered(id){return !!state['term_'+id];}
function isChecked(id){return !!state['check_'+id];}
function getApiKey(){return localStorage.getItem('pmo_gemini_key')||'';}

function calcTotal(){
  let done=0;
  STARS.forEach(s=>{if(getStarData(s.id).done)done++;});
  TERMS.forEach(t=>{if(isTermMastered(t.id))done++;});
  CHECKS.forEach(c=>{if(isChecked(c.id))done++;});
  return{done,total:25,pct:Math.round(done/25*100)};
}
function calcPhase(ids,type){
  let done=0;
  if(type==='star')ids.forEach(id=>{if(getStarData(id).done)done++;});
  else if(type==='term')ids.forEach(id=>{if(isTermMastered(id))done++;});
  else ids.forEach(id=>{if(isChecked(id))done++;});
  return{done,total:ids.length,pct:Math.round(done/ids.length*100)};
}

