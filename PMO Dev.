    return;
  }
  const btn=document.getElementById('btn-analyze');
  btn.disabled=true;
  btn.innerHTML=`<div class="spinner"></div><span>جيمناي يقرأ قصصك...</span>`;
  const storiesText=completed.map(s=>{
    const d=getStarData(s.id);
    return `## قصة: ${s.title}\n- الموقف: ${d.situation}\n- المهمة: ${d.task}\n- الإجراء: ${d.action}\n- النتيجة: ${d.result}`;
  }).join('\n\n');
  const prompt=`أنت خبير في تدريب المديرين التنفيذيين على المقابلات الوظيفية رفيعة المستوى. قم بتحليل قصص STAR التالية لمدير مكتب إدارة مشاريع (PMO) يتحضر لمقابلة تنفيذية:\n\n${storiesText}\n\nقدّم تحليلاً باللغة العربية يشمل:\n1. تقييم كل قصة (نقاط القوة والضعف)\n2. هل النتائج مدعومة بأرقام كافية؟\n3. 3 اقتراحات تحسين عملية لكل قصة\n4. تقييم عام من 10\n\nاستخدم نبرة مشجعة ومهنية.`;
  try{
    const result=await callGemini(prompt);
    document.getElementById('analysis-result').innerHTML=`
      <div style="background:#1a2540;border:1px solid rgba(79,142,247,0.3);border-radius:14px;padding:16px;margin-top:4px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid #253352;">
          <span style="font-size:18px;">🤖</span>
          <span style="font-size:13px;font-weight:700;color:#93c5fd;">تحليل جيمناي</span>
        </div>
        <div style="font-size:13px;color:var(--text3);line-height:1.8;white-space:pre-wrap;direction:rtl;">${result}</div>
      </div>`;
  }catch(e){
    showGeminiError(e,'analysis-result');
  }
  btn.disabled=false;
  btn.innerHTML=`<span>✨</span> حلّل قصصي مجدداً`;
}

