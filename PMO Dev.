  addChatBubble('ai','جاهز! سأجري معك مقابلة تنفيذية محاكية. سأطرح عليك أسئلة حقيقية وأقيّم إجاباتك.\n\nلنبدأ...');
  const completedStories=STARS.filter(s=>getStarData(s.id).done).map(s=>s.title).join('، ');
  const context=completedStories?`المرشح لديه قصص STAR في: ${completedStories}`:'المرشح لم يكمل قصص STAR بعد';
  const systemMsg=`أنت محاور تنفيذي خبير يُجري مقابلة لمنصب رفيعة المستوى مع مدير PMO. ${context}. اطرح سؤالاً تنفيذياً واحداً فقط في كل مرة، باللغة العربية، وبعد الإجابة قيّمها وانتقل للسؤال التالي. كن صارماً ومهنياً.`;
  const firstPrompt=`${systemMsg}\n\nابدأ بالسؤال الأول من المقابلة.`;
  await sendToInterview(firstPrompt,true);
}

async function sendInterviewAnswer(){
  const input=document.getElementById('interview-answer');
  const answer=input.value.trim();
  if(!answer)return;
  input.value='';
  addChatBubble('user',answer);
  interviewHistory.push({role:'user',parts:[{text:answer}]});
  const btn=document.getElementById('btn-send-answer');
  btn.disabled=true;
  btn.innerHTML=`<div class="spinner"></div>`;
  addTypingIndicator();
  try{
    const messages=buildInterviewMessages(answer);
    const response=await callGeminiChat(messages);
    removeTypingIndicator();
    addChatBubble('ai',response);
    interviewHistory.push({role:'model',parts:[{text:response}]});
  }catch(e){
    removeTypingIndicator();
    addChatBubble('ai','عذراً، حدث خطأ في الاتصال. حاول مرة أخرى.');
  }
  btn.disabled=false;
  btn.innerHTML='<span>إرسال الإجابة</span>';
}

function buildInterviewMessages(latestAnswer){
  const completedStories=STARS.filter(s=>getStarData(s.id).done).map(s=>s.title).join('، ');
  const context=completedStories?`المرشح لديه قصص STAR في: ${completedStories}`:'';
  const sys=`أنت محاور تنفيذي خبير يُجري مقابلة لمنصب PMO رفيع. ${context}. قيّم الإجابة الأخيرة وانتقل للسؤال التالي. اللغة عربية فقط.`;
  const msgs=[{role:'user',parts:[{text:sys}]},{role:'model',parts:[{text:'فهمت.'}]}];
  interviewHistory.forEach(m=>msgs.push(m));
  return msgs;
}

async function sendToInterview(prompt,isFirst=false){
  addTypingIndicator();
  try{
    const msgs=isFirst?[{role:'user',parts:[{text:prompt}]}]:buildInterviewMessages('');
    const response=await callGeminiChat(isFirst?msgs:msgs);
    removeTypingIndicator();
    addChatBubble('ai',response);
    if(isFirst)interviewHistory.push({role:'model',parts:[{text:response}]});
  }catch(e){
    removeTypingIndicator();
    addChatBubble('ai','عذراً، حدث خطأ في الاتصال. تأكد من صحة مفتاح API.');
  }
}

