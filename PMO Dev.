// ══════════════════ NAVIGATION ══════════════════
function showScreen(name){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('screen-'+name).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n=>{n.classList.remove('active');n.style.color='var(--slate)';});
  const navMap={dashboard:'nav-dashboard',phase1:'nav-phase1',phase2:'nav-phase2',phase3:'nav-phase3',ai:'nav-ai',settings:'nav-settings'};
  const navEl=document.getElementById(navMap[name]);
  if(navEl){navEl.classList.add('active');navEl.style.color='var(--gold)';}
  if(name==='dashboard')renderDashboard();
  if(name==='phase1')renderPhase1();
  if(name==='phase2')renderPhase2();
  if(name==='phase3')renderPhase3();
  if(name==='settings'){
    const key=getApiKey();
    if(key)document.getElementById('api-key-input').value=key;
  }
  window.scrollTo(0,0);
}

