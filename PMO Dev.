  document.getElementById('total-pct').textContent=prog.pct+'%';
  document.getElementById('total-bar').style.width=prog.pct+'%';
  document.getElementById('total-label').textContent=prog.done+' من '+prog.total+' مهمة مكتملة';
  renderApiStatusBanner();
  const phases=[
    {screen:'phase1',icon:'⭐',color:'#f59e0b',label:'المرحلة الأولى',sub:'قصص STAR الذهبية الخمس',type:'star',ids:STARS.map(s=>s.id)},
    {screen:'phase2',icon:'🃏',color:'#818cf8',label:'المرحلة الثانية',sub:'10 مصطلحات أساسية',type:'term',ids:TERMS.map(t=>t.id)},
    {screen:'phase3',icon:'✅',color:'#10b981',label:'المرحلة الثالثة',sub:'هندسة الحوار والمقابلة',type:'check',ids:CHECKS.map(c=>c.id)},
    {screen:'ai',icon:'🤖',color:'#4f8ef7',label:'جيمناي AI',sub:'تحليل قصصك + مقابلة تجريبية',type:'ai',ids:[]},
  ];
  const pc=document.getElementById('phase-cards');
  pc.innerHTML='';
  phases.forEach(p=>{
    const ph=p.type==='ai'?{done:0,total:0,pct:getApiKey()?100:0}:calcPhase(p.ids,p.type);
    const done=ph.pct===100;
    const isAi=p.type==='ai';
    const card=document.createElement('div');
    card.className='card-hover';
    card.style.cssText=`background:#1e293b;border:1px solid #334155;border-radius:16px;padding:16px;margin-bottom:12px;cursor:pointer;`;
    card.onclick=()=>showScreen(p.screen);
    card.innerHTML=`
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
        <div style="width:44px;height:44px;background:${p.color}18;border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;">${p.icon}</div>
        <div style="flex:1;">
          <p style="font-size:10px;letter-spacing:2px;color:${p.color};font-weight:700;margin:0 0 2px;">${p.label.toUpperCase()}</p>
          <p style="font-size:15px;font-weight:700;color:var(--text);margin:0;">${p.sub}</p>
        </div>
        ${isAi?'<span class="gemini-badge">AI</span>':''}
      </div>
      ${!isAi?`
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
        <span style="font-size:11px;color:var(--slate);">${ph.done} من ${ph.total} مكتملة</span>
        <span style="font-size:12px;font-weight:800;color:${p.color};">${ph.pct}%</span>
      </div>
      <div style="background:#0f172a;border-radius:6px;height:7px;overflow:hidden;margin-bottom:14px;">
        <div class="progress-bar-inner" style="height:100%;border-radius:6px;background:${p.color};width:${ph.pct}%;"></div>
      </div>`:'<div style="margin-bottom:14px;"></div>'}
      <div style="display:flex;align-items:center;justify-content:space-between;">
        <span style="font-size:11px;padding:3px 10px;border-radius:20px;font-weight:700;${isAi?(getApiKey()?'background:rgba(79,142,247,0.15);color:#93c5fd;':'background:#334155;color:var(--slate);'):(done?'background:rgba(16,185,129,0.15);color:#34d399;':'background:#334155;color:var(--slate);')}">${isAi?(getApiKey()?'✓ متصل':'يحتاج مفتاح'):(done?'✓ مكتمل':'جارٍ التنفيذ')}</span>
        <button onclick="event.stopPropagation();showScreen('${p.screen}')" style="background:${isAi?'linear-gradient(135deg,#4f8ef7,#7c3aed)':(done?'var(--emerald)':'var(--gold)')};color:white;padding:7px 16px;font-size:12px;border-radius:8px;border:none;cursor:pointer;font-weight:700;font-family:'Cairo',sans-serif;">${isAi?'فتح جيمناي':(done?'مراجعة':'ابدأ الآن')}</button>
      </div>`;
    pc.appendChild(card);
  });
}

// ══════════════════ PHASE 1 ══════════════════
function renderPhase1(){
  const list=document.getElementById('star-list');
  list.innerHTML='';
  STARS.forEach(s=>{
    const d=getStarData(s.id);
    const el=document.createElement('div');
    el.className='story-item'+(d.done?' done':'');
    el.style.cssText=`background:#1e293b;border:1px solid #334155;border-radius:13px;padding:15px 16px;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;gap:12px;`;
    el.onclick=()=>openStarModal(s.id);
    el.innerHTML=`
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="font-size:22px;">${s.icon}</span>
        <div>
          <p style="font-size:14px;font-weight:700;color:var(--text);margin:0 0 2px;">${s.title}</p>
          <p style="font-size:11px;color:var(--slate);margin:0;">${s.desc}</p>
        </div>
      </div>
      ${d.done?'<span style="background:rgba(16,185,129,0.15);color:#34d399;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;">✓ مكتمل</span>':'<span style="font-size:22px;color:var(--gold);">›</span>'}`;
    list.appendChild(el);
  });
}

function openStarModal(id){
  const s=STARS.find(x=>x.id===id);
  const d=getStarData(id);
  const fields=[
    {key:'situation',label:'الموقف (Situation)',placeholder:'صِف السياق والخلفية بالتفصيل...'},
    {key:'task',label:'المهمة (Task)',placeholder:'ما الذي كنت مسؤولاً عنه بالتحديد؟'},
    {key:'action',label:'الإجراء (Action)',placeholder:'ما الخطوات التي اتخذتها بشكل شخصي؟'},
    {key:'result',label:'النتيجة بالأرقام (Result)',placeholder:'مثال: وفّرنا 40% من التكاليف، أنجزنا قبل الموعد بأسبوعين...'},
  ];
  document.getElementById('modal-content').innerHTML=`
    <p style="font-size:16px;font-weight:800;color:var(--gold);margin-bottom:18px;">${s.icon} ${s.title}</p>
    ${fields.map(f=>`
      <p style="font-size:11px;font-weight:700;color:var(--slate);margin-bottom:5px;margin-top:14px;">${f.label}</p>
      <textarea id="f-${f.key}" style="width:100%;background:#0f172a;border:1px solid #334155;border-radius:10px;color:var(--text);padding:10px 12px;font-size:13px;font-family:'Cairo',sans-serif;min-height:70px;direction:rtl;" placeholder="${f.placeholder}">${d[f.key]||''}</textarea>

```
`).join('')}
<div style="display:flex;gap:10px;margin-top:18px;">
  <button class="btn-primary" style="flex:1;padding:11px;" onclick="saveStory('${id}')">حفظ وإنجاز ✓</button>
  <button class="btn-outline" onclick="closeModal()">إغلاق</button>
</div>`;
```

document.getElementById(‘modal’).style.display=‘flex’;
}

function saveStory(id){
state[‘star_’+id]={
situation:document.getElementById(‘f-situation’).value,
task:document.getElementById(‘f-task’).value,
action:document.getElementById(‘f-action’).value,
result:document.getElementById(‘f-result’).value,
done:true
};
saveState();closeModal();renderPhase1();renderDashboard();
}

// ══════════════════ PHASE 2 ══════════════════
function renderPhase2(){
const grid=document.getElementById(‘fc-grid’);
grid.innerHTML=’’;
TERMS.forEach(t=>{
const mastered=isTermMastered(t.id);
const wrapper=document.createElement(‘div’);
wrapper.style.cssText=‘display:flex;flex-direction:column;’;
const card=document.createElement(‘div’);
card.id=‘fc-’+t.id;
card.className=‘fc-card flip-card’+(mastered?’ mastered’:’’);
card.style.cssText=`background:#1e293b;border:1px solid #334155;border-radius:14px 14px 0 0;padding:0;position:relative;display:flex;flex-direction:column;`;
card.innerHTML=` <div class="flip-card-inner" style="padding:14px;min-height:130px;"> <div class="flip-card-front" style="display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:102px;"> <p style="font-size:13px;font-weight:800;color:var(--gold);line-height:1.4;margin-bottom:8px;">${t.term}</p> <p style="font-size:10px;color:var(--slate);">اضغط للتعريف</p> </div> <div class="flip-card-back" style="min-height:102px;"> <p style="font-size:11px;color:#e2e8f0;line-height:1.6;margin-bottom:6px;text-align:right;">${t.def}</p> <p style="font-size:10px;color:var(--slate);font-style:italic;text-align:right;">${t.example}</p> </div> </div>`;
card.addEventListener(‘click’,()=>card.classList.toggle(‘flipped’));
const btn=document.createElement(‘button’);
btn.id=‘mb-’+t.id;
btn.style.cssText=`width:100%;border-radius:0 0 14px 14px;border:none;border-top:1px solid #334155;background:${mastered?'rgba(16,185,129,0.15)':'transparent'};color:${mastered?'#34d399':'var(--slate)'};font-size:11px;font-weight:700;padding:8px;cursor:pointer;font-family:'Cairo',sans-serif;transition:background 0.2s;`;
btn.textContent=mastered?‘✓ تم الإتقان’:‘أتقنت هذا المصطلح’;
btn.onclick=(e)=>{e.stopPropagation();masterTerm(t.id);};
wrapper.appendChild(card);wrapper.appendChild(btn);
grid.appendChild(wrapper);
});
}

function masterTerm(id){
state[‘term_’+id]=true;saveState();
const btn=document.getElementById(‘mb-’+id);
const card=document.getElementById(‘fc-’+id);
if(card)card.classList.add(‘mastered’);
if(btn){btn.textContent=‘✓ تم الإتقان’;btn.style.background=‘rgba(16,185,129,0.15)’;btn.style.color=’#34d399’;}
renderDashboard();
}

// ══════════════════ PHASE 3 ══════════════════
function renderPhase3(){
const list=document.getElementById(‘checklist’);
list.innerHTML=’’;
CHECKS.forEach(c=>{
const checked=isChecked(c.id);
const el=document.createElement(‘div’);
el.className=‘checklist-item’+(checked?’ checked’:’’);
el.style.cssText=`background:#1e293b;border:1px solid #334155;border-radius:13px;padding:14px 16px;margin-bottom:10px;display:flex;align-items:flex-start;gap:12px;`;
el.onclick=()=>toggleCheck(c.id);
el.innerHTML=` <div style="width:22px;height:22px;border-radius:7px;border:2px solid ${checked?'var(--emerald)':'#475569'};background:${checked?'var(--emerald)':'transparent'};display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;transition:all 0.2s;"> ${checked?'<span style="color:white;font-size:13px;font-weight:900;">✓</span>':''} </div> <div> <p style="font-size:14px;font-weight:600;color:${checked?'var(--slate)':'var(--text)'};margin:0 0 3px;${checked?'text-decoration:line-through;':''}">${c.label}</p> <p style="font-size:11px;color:var(--slate);margin:0;line-height:1.5;">${c.sub}</p> </div>`;
list.appendChild(el);
});
}

function toggleCheck(id){state[‘check_’+id]=!isChecked(id);saveState();renderPhase3();renderDashboard();}

// ══════════════════ MODAL ══════════════════
function closeModal(){document.getElementById(‘modal’).style.display=‘none’;}
function handleModalBgClick(e){if(e.target===document.getElementById(‘modal’))closeModal();}

// ══════════════════ RESET ══════════════════
function resetAll(){
if(confirm(‘هل أنت متأكد؟ سيتم مسح جميع البيانات وبدء خطة جديدة من الصفر.’)){
localStorage.removeItem(STORAGE_KEY);
state={};
showScreen(‘dashboard’);
}
}

// ══════════════════ INIT ══════════════════
loadState();
renderDashboard();
</script>

