*{font-family:'Cairo',sans-serif;box-sizing:border-box;}
body{background:#060d1a;color:#f1f5f9;margin:0;padding:0;}
:root{
  --navy-950:#060d1a;--navy-900:#0f172a;--navy-800:#1a2540;--navy-700:#1e293b;--navy-500:#334155;
  --gold:#f59e0b;--gold-light:#fbbf24;--emerald:#10b981;--emerald-light:#34d399;
  --slate:#94a3b8;--text:#f1f5f9;--text2:#94a3b8;--text3:#cbd5e1;
  --gemini:#4f8ef7;--gemini-dark:#1a3a6b;
}
.screen{display:none;animation:fadeIn 0.3s ease;}
.screen.active{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
@keyframes slideUp{from{opacity:0;transform:translateY(30px);}to{opacity:1;transform:translateY(0);}}
@keyframes spin{to{transform:rotate(360deg);}}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.4;}}
.modal-anim{animation:slideUp 0.35s ease;}
.card-hover{transition:border-color 0.2s,transform 0.2s;}
.card-hover:hover{border-color:var(--gold)!important;transform:translateY(-2px);}
.progress-bar-inner{transition:width 0.6s cubic-bezier(0.4,0,0.2,1);}
.nav-item{transition:color 0.2s;}
.nav-item.active{color:var(--gold);}
.flip-card{perspective:800px;}
.flip-card-inner{transition:transform 0.55s cubic-bezier(0.4,0,0.2,1);transform-style:preserve-3d;position:relative;}
.flip-card.flipped .flip-card-inner{transform:rotateY(180deg);}
.flip-card-front,.flip-card-back{backface-visibility:hidden;-webkit-backface-visibility:hidden;}
.flip-card-back{transform:rotateY(180deg);position:absolute;top:0;left:0;width:100%;}
textarea{resize:vertical;outline:none;transition:border-color 0.2s;}
textarea:focus{border-color:var(--gold)!important;}
input[type=text],input[type=password]{outline:none;transition:border-color 0.2s;}
input[type=text]:focus,input[type=password]:focus{border-color:var(--gold)!important;}
.btn-primary{background:var(--gold);color:#0f172a;font-weight:700;border:none;cursor:pointer;transition:opacity 0.2s,transform 0.15s;border-radius:10px;padding:10px 20px;font-size:14px;font-family:'Cairo',sans-serif;}
.btn-primary:hover{opacity:0.88;}
.btn-primary:active{transform:scale(0.97);}
.btn-outline{background:transparent;border:1px solid var(--navy-500);color:var(--slate);cursor:pointer;transition:background 0.2s;border-radius:10px;padding:10px 20px;font-size:14px;font-family:'Cairo',sans-serif;}
.btn-outline:hover{background:var(--navy-700);}
.btn-danger{background:#ef4444;color:white;border:none;cursor:pointer;border-radius:8px;padding:8px 16px;font-size:13px;font-family:'Cairo',sans-serif;transition:opacity 0.2s;}
.btn-danger:hover{opacity:0.85;}
.btn-gemini{background:linear-gradient(135deg,#4f8ef7,#7c3aed);color:white;border:none;cursor:pointer;border-radius:10px;padding:10px 18px;font-size:13px;font-weight:700;font-family:'Cairo',sans-serif;transition:opacity 0.2s,transform 0.15s;display:flex;align-items:center;gap:6px;}
.btn-gemini:hover{opacity:0.9;}
.btn-gemini:active{transform:scale(0.97);}
.btn-gemini:disabled{opacity:0.5;cursor:not-allowed;}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.75);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;z-index:50;padding:16px;}
.modal-box{background:#1a2540;border:1px solid #334155;border-radius:20px;padding:24px;width:100%;max-width:500px;max-height:90vh;overflow-y:auto;}
.tip-box{border:1px solid rgba(245,158,11,0.2);background:rgba(245,158,11,0.05);border-radius:12px;}
.gemini-box{border:1px solid rgba(79,142,247,0.3);background:rgba(79,142,247,0.05);border-radius:14px;}
.chat-bubble-ai{background:#1a2540;border:1px solid #253352;border-radius:14px 14px 14px 4px;padding:12px 14px;margin-bottom:10px;font-size:13px;line-height:1.7;color:var(--text3);}
.chat-bubble-user{background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.2);border-radius:14px 14px 4px 14px;padding:12px 14px;margin-bottom:10px;font-size:13px;line-height:1.7;color:var(--text);text-align:right;}
.typing-dots span{display:inline-block;width:6px;height:6px;background:var(--gemini);border-radius:50%;margin:0 2px;animation:pulse 1.2s ease-in-out infinite;}
.typing-dots span:nth-child(2){animation-delay:0.2s;}
.typing-dots span:nth-child(3){animation-delay:0.4s;}
.spinner{width:18px;height:18px;border:2px solid rgba(255,255,255,0.3);border-top-color:white;border-radius:50%;animation:spin 0.7s linear infinite;}
.settings-row{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:14px 18px;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;}
.story-item{cursor:pointer;transition:border-color 0.2s,transform 0.15s;}
.story-item:hover{border-color:var(--gold)!important;transform:translateX(-3px);}
.story-item.done{border-color:var(--emerald)!important;}
.fc-card{cursor:pointer;transition:border-color 0.2s,transform 0.15s;min-height:130px;}
.fc-card:hover{border-color:var(--gold)!important;}
.fc-card.mastered{border-color:var(--emerald)!important;}
.checklist-item{cursor:pointer;transition:border-color 0.2s,background 0.2s;}
.checklist-item:hover{border-color:var(--gold)!important;background:rgba(245,158,11,0.05);}
.checklist-item.checked{border-color:var(--emerald)!important;}
.gemini-badge{background:linear-gradient(135deg,rgba(79,142,247,0.2),rgba(124,58,237,0.2));border:1px solid rgba(79,142,247,0.3);border-radius:8px;padding:2px 8px;font-size:10px;font-weight:700;color:#93c5fd;}
::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:#334155;border-radius:4px;}
.hero-glow{background:radial-gradient(ellipse at 50% 0%,rgba(245,158,11,0.08) 0%,transparent 70%);}
</style>
</head>
